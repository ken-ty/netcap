# Let netcap run unattended: only fixed netcap-netshape verbs are passwordless.
# Location: /etc/sudoers.d/netcap-netshape (0440 root:wheel). Installed by mac/install.sh
#
# Arguments are spelled out. status / get / off / on without arguments match exactly.
# Only on / set, which take numbers, use * (sudoers' * matches anything, including spaces,
# so the shaper checks the argument count and form — exit 2 unless two numbers).
# The shaper lives in /Library/PrivilegedHelperTools, writable only by root.
# In a user-writable directory, swapping it would be enough to get root.
Cmnd_Alias NETSHAPE = /Library/PrivilegedHelperTools/netcap-netshape status, \
                      /Library/PrivilegedHelperTools/netcap-netshape get, \
                      /Library/PrivilegedHelperTools/netcap-netshape off, \
                      /Library/PrivilegedHelperTools/netcap-netshape on, \
                      /Library/PrivilegedHelperTools/netcap-netshape on *, \
                      /Library/PrivilegedHelperTools/netcap-netshape set *
__USER__ ALL=(root) NOPASSWD: NETSHAPE
