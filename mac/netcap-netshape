#!/bin/bash
# netcap-netshape — この Mac 自身の WAN 向け通信に上限をかける (pf + dummynet)
#
#   netcap-netshape on [UP_MBIT DOWN_MBIT]  上限をかける (LaunchDaemon が起動時に呼ぶ)
#                                           引数を付けると今回だけその値。既定は変えない
#   netcap-netshape off                     上限を外す
#   netcap-netshape status                  いまの状態。1 行目は実物 (dnctl / pfctl) から導く
#   netcap-netshape set UP_MBIT DOWN_MBIT   既定を書き換える (再起動後も効く)。
#                                           いま上限がかかっていれば、その値で張り直す
#   netcap-netshape get                     既定と起動時の挙動を 1 行で
#
# 既定値は /etc/netcap-netshape.conf に置く (set が書く):
#   UP_MBIT=1
#   DOWN_MBIT=1
#
# 触るのは自分の持ち物だけ:
#   pf      アンカー com.apple/netcap-netshape の中だけ。main ruleset (/etc/pf.conf) は読み込まない。
#           macOS は起動時に /etc/pf.conf を読み、そこに dummynet-anchor "com.apple/*" がある
#   dnctl   pipe 1 (上り) と pipe 2 (下り) だけ。flush はしない
#
# root で動くので、本体・設定・アンカーはすべて root だけが書ける場所に置く (mac/install.sh が検査する)。
# 設定は source せず、key=value を数値として読むだけにする。
set -eu

UP_MBIT=1   # 上り。4G に落ちた夜は WAN 全体で 10Mbps も出ない (2026-09-20 実測)
DOWN_MBIT=1 # 下り。5〜10Mbit/s の DL だけで WAN 遅延が 500〜1600ms になった

CONF=/etc/netcap-netshape.conf
ANCHOR=com.apple/netcap-netshape
ANCHOR_FILE=/etc/pf.anchors/netcap-netshape
PIPE_UP=1
PIPE_DOWN=2
TOKEN=/var/run/netcap-netshape.token
APPLIED=/var/run/netcap-netshape.applied # on で適用した値 "UP DOWN" (下りの表示にだけ使う)
PLIST=/Library/LaunchDaemons/netcap-netshape.plist # あれば起動時に on

[ "$(id -u)" = 0 ] || {
  echo "root で実行してください (sudo)" >&2
  exit 1
}

is_number() { [[ "$1" =~ ^[0-9]+([.][0-9]+)?$ ]]; }

# 設定を読む。知らない行と数値でない値は無視する (source すると root でシェルが走る)
if [ -f "$CONF" ]; then
  while IFS='=' read -r key value; do
    is_number "${value:-}" || continue
    case "$key" in
      UP_MBIT) UP_MBIT=$value ;;
      DOWN_MBIT) DOWN_MBIT=$value ;;
    esac
  done <"$CONF"
fi

# main ruleset に com.apple/* の dummynet アンカーが無ければ、自分のルールは評価されない。
# そのときは main を差し替えずに止まる (差し替えると他人のルールを消す)
require_anchor_point() {
  pfctl -s dummynet 2>/dev/null | grep -q 'dummynet-anchor "com.apple/\*"' || {
    echo "main ruleset に dummynet-anchor \"com.apple/*\" が無い。" \
      "/etc/pf.conf 以外のルールが読み込まれている。確認してから sudo pfctl -f /etc/pf.conf" >&2
    exit 3
  }
}

on() {
  if [ $# -ge 1 ]; then
    [ $# -eq 2 ] && is_number "$1" && is_number "$2" || {
      echo "usage: $0 on [UP_MBIT DOWN_MBIT]" >&2
      exit 2
    }
    UP_MBIT=$1
    DOWN_MBIT=$2
  fi
  require_anchor_point
  dnctl -q pipe "$PIPE_UP" config bw "${UP_MBIT}Mbit/s" queue 20
  dnctl -q pipe "$PIPE_DOWN" config bw "${DOWN_MBIT}Mbit/s" queue 50
  pfctl -q -a "$ANCHOR" -f "$ANCHOR_FILE"
  # pf の有効化は参照カウント。自分の token を持ち、off で自分の分だけ返す
  if [ ! -s "$TOKEN" ]; then
    pfctl -E 2>&1 | sed -n 's/.*Token *: *\([0-9]*\).*/\1/p' >"$TOKEN"
  fi
  echo "${UP_MBIT} ${DOWN_MBIT}" >"$APPLIED"
  echo "netshape ON  up=${UP_MBIT}Mbit/s down=${DOWN_MBIT}Mbit/s"
}

off() {
  pfctl -q -a "$ANCHOR" -F all 2>/dev/null || true
  dnctl -q pipe delete "$PIPE_UP" "$PIPE_DOWN" 2>/dev/null || true
  if [ -s "$TOKEN" ]; then
    pfctl -q -X "$(cat "$TOKEN")" || true
    rm -f "$TOKEN"
  fi
  rm -f "$APPLIED"
  echo "netshape OFF"
}

# pipe 1 の帯域を Mbit/s で返す。無ければ空。
#   00001:   1.000 Mbit/s    0 ms   20 sl. ...   /   00001: unlimited ...
# macOS の dnctl は 2 本目以降の pipe の見出し行を出さない (`pipe 2 show` は空、
# `-s list` は segfault。2026-09-21 MBP で実測)。だから読めるのは pipe 1 だけ。
pipe1_mbit() {
  dnctl list 2>/dev/null | awk '
    $1 == "00001:" {
      if ($2 == "unlimited") { print "unlimited"; exit }
      v = $2 + 0; u = $3
      if (u == "Kbit/s") v = v / 1000
      else if (u == "bit/s") v = v / 1000000
      else if (u == "Gbit/s") v = v * 1000
      printf "%g\n", v; exit
    }'
}

# pipe の本数。見出し行は出ないが pipe ごとの "mask:" 行は出るので、それを数える。
# dnctl は全体しか見せないので、他の道具 (Network Link Conditioner など) の pipe も数えてしまう
pipe_count() {
  dnctl list 2>/dev/null | grep -c "^ *mask:" || true
}

anchor_rules() {
  pfctl -a "$ANCHOR" -s dummynet 2>/dev/null | grep -c "pipe" || true
}

# 既定を書き換える。書きかけを読ませないよう mktemp 経由で置き換える。
# いま上限がかかっていれば、その値で張り直す (tailscale set と同じで、
# 「設定を変える」が「いまの状態を壊す」ことにならないようにする)
set_default() {
  [ $# -eq 2 ] && is_number "$1" && is_number "$2" || {
    echo "usage: $0 set UP_MBIT DOWN_MBIT" >&2
    exit 2
  }
  local tmp
  tmp=$(mktemp)
  cat >"$tmp" <<EOF
# netcap-netshape の既定値。netcap-netshape set が書く
UP_MBIT=$1
DOWN_MBIT=$2
EOF
  install -o root -g wheel -m 0644 "$tmp" "$CONF"
  rm -f "$tmp"
  UP_MBIT=$1
  DOWN_MBIT=$2
  if [ "$(anchor_rules)" -ge 2 ]; then
    on "$1" "$2" >/dev/null
    echo "netshape SET up=${1}Mbit/s down=${2}Mbit/s (適用中だったので張り直した)"
  else
    echo "netshape SET up=${1}Mbit/s down=${2}Mbit/s (次の on / 再起動から効く)"
  fi
}

# 設定を返す。実物ではなく「再起動したらどうなるか」の側
get() {
  local boot=off
  [ -f "$PLIST" ] && boot=on
  echo "netshape default_up=${UP_MBIT} default_down=${DOWN_MBIT} boot=${boot} conf=$([ -f "$CONF" ] && echo "$CONF" || echo none)"
}

status() {
  local rules up down pipes state down_src
  rules=$(anchor_rules)
  pipes=$(pipe_count)
  up=$(pipe1_mbit)
  # 下りは pipe 2 の実在だけ dnctl で確かめ、値は on で書いた記録から読む (表示バグの回避)
  down=""; down_src=none
  if [ "$pipes" -ge 2 ] && [ -s "$APPLIED" ]; then
    down=$(awk '{print $2}' "$APPLIED")
    down_src=applied
  fi
  if [ "$rules" -ge 2 ] && [ -n "$up" ] && [ "$pipes" -ge 2 ]; then
    state=on
  elif [ "$rules" -eq 0 ] && [ -z "$up" ]; then
    state=off
  else
    state=partial # ルールと pipe が食い違っている。on か off を打ち直す
  fi
  echo "netshape state=${state} up_mbit=${up:--} down_mbit=${down:--} down_src=${down_src} pipes=${pipes} rules=${rules}"
  pfctl -s info 2>/dev/null | head -1
  echo "--- pipes (dnctl は pipe 1 の見出しだけ出す。mask: の行数が pipe の本数)"
  dnctl list 2>/dev/null || echo "(none)"
  echo "--- rules (anchor ${ANCHOR})"
  pfctl -a "$ANCHOR" -s dummynet 2>/dev/null | grep -v "^$" || echo "(no dummynet rules)"
}

case "${1:-}" in
  on) shift; on "$@" ;;
  off) off ;;
  status) status ;;
  set) shift; set_default "$@" ;;
  get) get ;;
  *)
    echo "usage: $0 {on [UP_MBIT DOWN_MBIT]|off|status|set UP_MBIT DOWN_MBIT|get}" >&2
    exit 2
    ;;
esac
