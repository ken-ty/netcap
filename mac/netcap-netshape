#!/bin/bash
# netcap-netshape — cap this Mac's own WAN-bound traffic (pf + dummynet)
#
#   netcap-netshape on [UP_MBIT DOWN_MBIT] [--for SECONDS]
#                                           apply the cap (the LaunchDaemon calls this at boot)
#                                           with arguments, use them this time only; default unchanged.
#                                           --for: lift it by itself after SECONDS (60 to 86400). Without it,
#                                           an earlier --for is cancelled
#   netcap-netshape off                     lift the cap (and cancel --for)
#   netcap-netshape expire                  lift the cap if the --for deadline has passed (launchd calls this)
#   netcap-netshape status                  current state. Line 1 is derived from the real thing (dnctl / pfctl)
#   netcap-netshape set UP_MBIT DOWN_MBIT   rewrite the default (persists across reboot).
#                                           if a cap is in effect, reapply it with these values
#   netcap-netshape get                     default and boot behavior, on one line
#
# Defaults live in /etc/netcap-netshape.conf (written by set):
#   UP_MBIT=1
#   DOWN_MBIT=1
#
# Touch only what we own:
#   pf      only inside anchor com.apple/netcap-netshape. Never loads the main ruleset (/etc/pf.conf).
#           macOS loads /etc/pf.conf at boot, and it has dummynet-anchor "com.apple/*"
#   dnctl   only pipe 1 (upload) and pipe 2 (download). Never flush
#
# Runs as root, so the shaper, config and anchor all live where only root can write (mac/install.sh checks).
# The config is never sourced; key=value is only read as numbers.
set -eu

UP_MBIT=1   # upload. On nights it falls back to 4G, the whole WAN stays under 10Mbps (measured 2026-09-20)
DOWN_MBIT=1 # download. A 5-10Mbit/s download alone pushed WAN latency to 500-1600ms

CONF=/etc/netcap-netshape.conf
ANCHOR=com.apple/netcap-netshape
ANCHOR_FILE=/etc/pf.anchors/netcap-netshape
PIPE_UP=1
PIPE_DOWN=2
TOKEN=/var/run/netcap-netshape.token
APPLIED=/var/run/netcap-netshape.applied # values applied by on, "UP DOWN" (used only to display download)
PLIST=/Library/LaunchDaemons/netcap-netshape.plist # if present, on at boot
# on --for: the deadline (epoch seconds), and a job launchd starts every minute while it is loaded. launchd runs a
# calendar job missed during sleep once on wake, so the cap is lifted within a minute of waking (launchd.plist(5))
UNTIL=/var/run/netcap-netshape.until
EXPIRE_PLIST=/Library/PrivilegedHelperTools/netcap-netshape-expire.plist
EXPIRE_JOB=system/netcap-netshape-expire

[ "$(id -u)" = 0 ] || {
  echo "run as root (sudo)" >&2
  exit 1
}

is_number() { [[ "$1" =~ ^[0-9]+([.][0-9]+)?$ ]]; }

# Print "<bit/s> <Mbit/s>" for a value in Mbit/s, or fail if dnctl cannot hold it. dnctl reads bw with
# strtoul(base 0) into an int and scales only on a K or M right after the digits (network_cmds dnctl/dnctl.c):
# 0.5Mbit/s would be 0 = unlimited, 08 would be 0, 010 octal 8, and past 2^31-1 bit/s it fails or wraps (#86).
# So dnctl gets whole bit/s in base 10 (awk reads 08 as 8). The Mbit/s form drops leading and trailing zeros
rate() {
  awk -v v="$1" 'BEGIN {
    b = int(v * 1000000 + 0.5)
    if (b < 1 || b > 2147483647) exit 1
    m = sprintf("%.6f", b / 1000000); sub(/0+$/, "", m); sub(/[.]$/, "", m)
    printf "%d %s\n", b, m
  }'
}

# Check both values before anything is changed. Sets UP_BIT DOWN_BIT, and UP_MBIT DOWN_MBIT in canonical form
rates() {
  local up down
  up=$(rate "$1") && down=$(rate "$2") || {
    echo "Mbit/s must be 0.000001 to 2147.483647 on macOS (dummynet holds bit/s in a 32-bit int): up=$1 down=$2" >&2
    exit 2
  }
  UP_BIT=${up% *}
  UP_MBIT=${up#* }
  DOWN_BIT=${down% *}
  DOWN_MBIT=${down#* }
}

# Read the config. Ignore unknown lines and non-numeric values (sourcing would run a shell as root)
if [ -f "$CONF" ]; then
  while IFS='=' read -r key value; do
    is_number "${value:-}" || continue
    case "$key" in
      UP_MBIT) UP_MBIT=$value ;;
      DOWN_MBIT) DOWN_MBIT=$value ;;
    esac
  done <"$CONF"
fi

# Without a com.apple/* dummynet anchor in the main ruleset, our rules are never evaluated.
# In that case stop without replacing main (replacing it would wipe others' rules).
# At boot, com.apple.pfctl may load /etc/pf.conf after the boot job starts (launchd does not order them), so the boot
# job (NETCAP_BOOT=1, set by its plist) waits up to a minute for it instead of leaving the device uncapped
require_anchor_point() {
  local wait=0
  [ "${NETCAP_BOOT:-}" = 1 ] && wait=60
  until pfctl -s dummynet 2>/dev/null | grep -q 'dummynet-anchor "com.apple/\*"'; do
    [ "$wait" -gt 0 ] || {
      echo "main ruleset has no dummynet-anchor \"com.apple/*\"." \
        "Rules other than /etc/pf.conf are loaded. Check, then sudo pfctl -f /etc/pf.conf" >&2
      exit 3
    }
    sleep 1
    wait=$((wait - 1))
  done
}

pf_enabled() { pfctl -s info 2>/dev/null | grep -q '^Status: Enabled'; }

apply() {
  if [ $# -ge 1 ]; then
    [ $# -eq 2 ] && is_number "$1" && is_number "$2" || {
      echo "usage: $0 on [UP_MBIT DOWN_MBIT] [--for SECONDS]" >&2
      exit 2
    }
    UP_MBIT=$1
    DOWN_MBIT=$2
  fi
  rates "$UP_MBIT" "$DOWN_MBIT"
  require_anchor_point
  dnctl -q pipe "$PIPE_UP" config bw "${UP_BIT}bit/s" queue 20
  dnctl -q pipe "$PIPE_DOWN" config bw "${DOWN_BIT}bit/s" queue 50
  pfctl -q -a "$ANCHOR" -f "$ANCHOR_FILE"
  # pf enabling is reference-counted. Hold our own token and release only ours on off. If something else disabled pf
  # (pfctl -d), the token no longer keeps it on: give it back and take a new one
  if [ -s "$TOKEN" ] && ! pf_enabled; then
    pfctl -q -X "$(cat "$TOKEN")" 2>/dev/null || true
    rm -f "$TOKEN"
  fi
  if [ ! -s "$TOKEN" ]; then
    pfctl -E 2>&1 | sed -n 's/.*Token *: *\([0-9]*\).*/\1/p' >"$TOKEN"
  fi
  echo "${UP_MBIT} ${DOWN_MBIT}" >"$APPLIED"
  echo "netshape ON  up=${UP_MBIT}Mbit/s down=${DOWN_MBIT}Mbit/s"
}

remove() {
  pfctl -q -a "$ANCHOR" -F all 2>/dev/null || true
  dnctl -q pipe delete "$PIPE_UP" "$PIPE_DOWN" 2>/dev/null || true
  if [ -s "$TOKEN" ]; then
    pfctl -q -X "$(cat "$TOKEN")" || true
    rm -f "$TOKEN"
  fi
  rm -f "$APPLIED"
  echo "netshape OFF"
}

stop_timer() {
  rm -f "$UNTIL"
  # When the deadline lifts the cap, this runs inside the job itself and bootout ends it: keep it last
  launchctl bootout "$EXPIRE_JOB" 2>/dev/null || true
}

start_timer() {
  echo $(($(date +%s) + $1)) >"$UNTIL"
  launchctl bootout "$EXPIRE_JOB" 2>/dev/null || true
  launchctl bootstrap system "$EXPIRE_PLIST"
}

on() {
  local for=
  if [ $# -ge 2 ] && [ "${*: -2:1}" = --for ]; then
    for=${*: -1}
    [[ "$for" =~ ^[0-9]+$ ]] && [ "$for" -ge 60 ] && [ "$for" -le 86400 ] || {
      echo "--for takes seconds, 60 to 86400: $for" >&2
      exit 2
    }
    set -- "${@:1:$(($# - 2))}"
  fi
  apply "$@"
  if [ -z "$for" ]; then
    stop_timer
  elif ! start_timer "$for"; then
    # Never leave a cap that was meant to end
    off >/dev/null
    echo "could not start the timer for --for; lifted the cap" >&2
    exit 3
  fi
}

off() {
  remove
  stop_timer
}

expire() {
  if [ ! -s "$UNTIL" ]; then
    stop_timer
  elif [ "$(date +%s)" -ge "$(cat "$UNTIL")" ]; then
    off
  fi
}

# until=<epoch> left=<seconds> while --for is pending, else -
timer_fields() {
  local until
  until=$(cat "$UNTIL" 2>/dev/null || true)
  if [[ "$until" =~ ^[0-9]+$ ]]; then
    local left=$((until - $(date +%s)))
    echo "until=${until} left=$((left > 0 ? left : 0))"
  else
    echo "until=- left=-"
  fi
}

# Print pipe 1's bandwidth in Mbit/s. Empty if absent.
#   00001:   1.000 Mbit/s    0 ms   20 sl. ...   /   00001: unlimited ...
# macOS dnctl omits the header line for every pipe after the first (`pipe 2 show` is empty,
# `-s list` segfaults; measured on MBP 2026-09-21). So only pipe 1 is readable.
pipe1_mbit() {
  dnctl list 2>/dev/null | awk '
    $1 == "00001:" {
      if ($2 == "unlimited") { print "unlimited"; exit }
      v = $2 + 0; u = $3
      if (u == "Kbit/s") v = v / 1000
      else if (u == "bit/s") v = v / 1000000
      else if (u == "Gbit/s") v = v * 1000
      printf "%g\n", v; exit
    }'
}

# Number of pipes. Headers are missing but each pipe prints a "mask:" line, so count those.
# dnctl only shows everything, so pipes from other tools (Network Link Conditioner etc.) are counted too
pipe_count() {
  dnctl list 2>/dev/null | grep -c "^ *mask:" || true
}

anchor_rules() {
  pfctl -a "$ANCHOR" -s dummynet 2>/dev/null | grep -c "pipe" || true
}

# Rewrite the default. Replace via mktemp so a half-written file is never read.
# If a cap is in effect, reapply it with the new values (like tailscale set,
# so that "changing a setting" does not mean "breaking the current state")
set_default() {
  [ $# -eq 2 ] && is_number "$1" && is_number "$2" || {
    echo "usage: $0 set UP_MBIT DOWN_MBIT" >&2
    exit 2
  }
  rates "$1" "$2"
  set -- "$UP_MBIT" "$DOWN_MBIT"
  local tmp
  tmp=$(mktemp)
  cat >"$tmp" <<EOF
# netcap-netshape defaults. Written by netcap-netshape set
UP_MBIT=$1
DOWN_MBIT=$2
EOF
  install -o root -g wheel -m 0644 "$tmp" "$CONF"
  rm -f "$tmp"
  UP_MBIT=$1
  DOWN_MBIT=$2
  if [ "$(anchor_rules)" -ge 2 ]; then
    apply "$1" "$2" >/dev/null # keeps a pending --for
    echo "netshape SET up=${1}Mbit/s down=${2}Mbit/s (reapplied, since a cap was in effect)"
  else
    echo "netshape SET up=${1}Mbit/s down=${2}Mbit/s (takes effect at the next on / reboot)"
  fi
}

# Print the settings: not the live state, but what happens after a reboot
get() {
  local boot=off
  [ -f "$PLIST" ] && boot=on
  echo "netshape default_up=${UP_MBIT} default_down=${DOWN_MBIT} boot=${boot} conf=$([ -f "$CONF" ] && echo "$CONF" || echo none)"
}

status() {
  local rules up down pipes state down_src
  rules=$(anchor_rules)
  pipes=$(pipe_count)
  up=$(pipe1_mbit)
  # For download, dnctl only confirms pipe 2 exists; the value comes from what on recorded (works around the display bug)
  down=""; down_src=none
  if [ "$pipes" -ge 2 ] && [ -s "$APPLIED" ]; then
    down=$(awk '{print $2}' "$APPLIED")
    down_src=applied
  fi
  if [ "$rules" -ge 2 ] && [ -n "$up" ] && [ "$pipes" -ge 2 ] && pf_enabled; then
    state=on
  elif [ "$rules" -eq 0 ] && [ -z "$up" ]; then
    state=off
  else
    state=partial # rules and pipes disagree, or pf is disabled (pfctl -s info below). Run on or off again
  fi
  echo "netshape state=${state} up_mbit=${up:--} down_mbit=${down:--} down_src=${down_src} pipes=${pipes} rules=${rules} $(timer_fields)"
  pfctl -s info 2>/dev/null | head -1
  echo "--- pipes (dnctl shows only pipe 1's header; the mask: line count is the pipe count)"
  dnctl list 2>/dev/null || echo "(none)"
  echo "--- rules (anchor ${ANCHOR})"
  pfctl -a "$ANCHOR" -s dummynet 2>/dev/null | grep -v "^$" || echo "(no dummynet rules)"
}

case "${1:-}" in
  on) shift; on "$@" ;;
  off) off ;;
  expire) expire ;;
  status) status ;;
  set) shift; set_default "$@" ;;
  get) get ;;
  *)
    echo "usage: $0 {on [UP_MBIT DOWN_MBIT] [--for SECONDS]|off|status|set UP_MBIT DOWN_MBIT|get}" >&2
    exit 2
    ;;
esac
