#!/bin/bash
# netcap-agent — the entry point netcap calls on the device. Also used as-is as an ssh forced command
#
#   netcap-agent <verb> [args...]              directly (as this machine's login user)
#   netcap-agent --allow "<verb> <verb> …"     as a forced command. The requested command
#                                              arrives in $SSH_ORIGINAL_COMMAND
#
# verbs: status get check on off set
#
# The controlled side decides what is allowed. One authorized_keys line limits what that key may request:
#
#   restrict,command="/Library/PrivilegedHelperTools/netcap-agent --allow 'status get check'" ssh-ed25519 AAAA… netcap@laptop
#
# A device set up like this can be read by netcap but its cap cannot be lifted. Even over ssh with that key,
# nothing but the listed verbs runs (no shell either; restrict disables pty and forwarding).
#
# Verbs that need root go to netcap-netshape via sudo -n. sudoers is also limited per verb,
# so anything that slips past here is stopped by sudoers.
set -eu

# Linux uses the same agent (installed by linux/install.sh). Only the shaper's location differs
case "$(uname)" in
  Darwin) NETSHAPE=/Library/PrivilegedHelperTools/netcap-netshape ;;
  *) NETSHAPE=/usr/libexec/netcap/netcap-netshape ;;
esac
CHECK=/usr/local/bin/netcap-check
VERBS="status get check on off set"

deny() {
  echo "netcap-agent: $*" >&2
  exit 77
}

allowed=$VERBS
if [ "${1:-}" = --allow ]; then
  [ $# -eq 2 ] || deny "usage: netcap-agent --allow \"<verb> …\""
  allowed=$2
  [ -n "${SSH_ORIGINAL_COMMAND:-}" ] || deny "call with a command (allowed verbs: $allowed)"
  # Split the request on whitespace only. No globbing, no quote handling
  set -f
  # shellcheck disable=SC2086
  set -- $SSH_ORIGINAL_COMMAND
  set +f
  # netcap sends "<path of this agent> <verb> …". Drop our own name at the front
  [ "${1##*/}" = netcap-agent ] && shift
fi

verb=${1:-}
[ -n "$verb" ] || deny "usage: netcap-agent <verb> [args...] (verbs: $VERBS)"
shift
case " $VERBS " in *" $verb "*) ;; *) deny "unknown verb: $verb" ;; esac
case " $allowed " in *" $verb "*) ;; *) deny "not allowed for this key: $verb (allowed: $allowed)" ;; esac

if [ "$verb" = check ]; then
  # Measurement needs no root. Only --bytes <number> is accepted
  if [ $# -gt 0 ]; then
    [ $# -eq 2 ] && [ "$1" = --bytes ] && [[ "$2" =~ ^[0-9]+$ ]] || deny "check accepts only --bytes <number>"
  fi
  exec "$CHECK" "$@"
fi

# Only on / set take numbers. The other verbs take no arguments
for a in "$@"; do
  [[ "$a" =~ ^[0-9]+([.][0-9]+)?$ ]] || deny "arguments must be numbers: $a"
done
exec sudo -n "$NETSHAPE" "$verb" "$@"
