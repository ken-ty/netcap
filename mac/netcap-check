#!/bin/bash
# netcap-check — measure WAN download / upload from this device, pinging 1.1.1.1 meanwhile.
# If the cap works, curl sticks to the cap and ping stays flat, since ICMP passes through the shaper.
#
#   netcap-check [--bytes N] [--ping-host H]
#
# No root needed (curl and ping only). The first line is key=value so netcap can parse it.
# At a 1 Mbit/s cap 1MB takes 8 seconds, so use a smaller --bytes when capped.
set -eu

BYTES=1000000
PING_HOST=1.1.1.1
while [ $# -gt 0 ]; do
  case "$1" in
    --bytes) BYTES=$2; shift 2 ;;
    --ping-host) PING_HOST=$2; shift 2 ;;
    *) echo "usage: $0 [--bytes N] [--ping-host H]" >&2; exit 2 ;;
  esac
done

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
head -c "$BYTES" /dev/urandom >"$tmp/up.bin"

# We want latency during the transfer, so ping runs alongside it
ping -i 0.5 -c 300 "$PING_HOST" >"$tmp/ping.txt" 2>&1 &
PING_PID=$!
sleep 1
down=$(curl -s -o /dev/null -w '%{speed_download}' "https://speed.cloudflare.com/__down?bytes=${BYTES}" || echo 0)
up=$(curl -s -o /dev/null -w '%{speed_upload}' -X POST --data-binary "@$tmp/up.bin" https://speed.cloudflare.com/__up || echo 0)
kill -INT "$PING_PID" 2>/dev/null || true
wait "$PING_PID" 2>/dev/null || true

# ping median / p95 / max. n=0 if none came back
read -r n med p95 max <<<"$(grep -o 'time=[0-9.]*' "$tmp/ping.txt" | cut -d= -f2 | sort -n | awk '
  { a[NR] = $1 }
  END {
    if (NR == 0) { print "0 - - -"; exit }
    printf "%d %.1f %.1f %.1f", NR, a[int((NR + 1) / 2)], a[int(NR * 0.95) ? int(NR * 0.95) : 1], a[NR]
  }')"

awk -v d="$down" -v u="$up" -v n="$n" -v med="$med" -v p95="$p95" -v max="$max" -v b="$BYTES" \
  'BEGIN { printf "netcheck down_mbit=%.2f up_mbit=%.2f ping_med=%s ping_p95=%s ping_max=%s ping_n=%s bytes=%s\n",
           d * 8 / 1000000, u * 8 / 1000000, med, p95, max, n, b }'
