#!/usr/bin/env python3
"""netcap — one command for the WAN bandwidth caps of the devices you manage.

  netcap status [host|all] [--json]           read the real state (pf pipes / QoS policy)
  netcap get    [host|all] [--json]           read the settings (default, boot behavior)
  netcap on     <host|all> [--up N --down N]  apply a cap; flags apply this time only
  netcap off    <host|all>                    remove the cap
  netcap set    <host|all> --up N --down N    change the default (survives reboots)
  netcap check  <host|all> [--json]           measure (curl up/down + ping)
  netcap use    <profile>                     apply a profile to all devices
  netcap profiles                             list profiles
  netcap install [name] [--ssh DEST]          install the agent on a device and register it
  netcap uninstall <name>                     remove the agent and the registration
  netcap rename <old> <new>                   rename a device in hosts and profiles
  netcap --version                            version (also -v)

The command layout is borrowed from tailscale. status (real state) and get (settings) are separate
commands, set changes only the persistent settings, and the flags of on are "the complete desired state
for this time". Only the verbs are not borrowed: netcap's domain already uses up/down for upload and
download, so it keeps on/off instead of tailscale's up/down.

What runs on each device:
  mac              : /Library/PrivilegedHelperTools/netcap-agent    (entry point; also the forced command)
                       → netcap-netshape (pf + dummynet; sudo -n) / netcap-check (measurement; no root)
  linux            : /usr/libexec/netcap/netcap-agent               (entry point; the same agent as mac)
                       → netcap-netshape (tc; sudo -n) / netcap-check (measurement; no root)
  win              : C:\\ProgramData\\netcap\\netcap-agent.ps1        (entry point; also the forced command)
                       → netshape.ps1 (NetQosPolicy; upload only) / netcap-check.ps1 (measurement)
Each returns key=value on its first line, which is what gets read.

Which devices to manage (hosts) and which to move together (profiles) belong to the user.
They are not in the code but in ~/.config/netcap/ (override with $NETCAP_CONFIG_DIR).
See examples/ for the format. Both are plain text, one entry per line; everything after # is a comment.
"""
import argparse
import base64
import json
import os
import re
import shlex
import shutil
import socket
import subprocess
import sys
import tempfile
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

# The brew formula replaces this with the version (the tag without the v) at install time.
# If it was not replaced, we are running straight from the repository, so use git describe
VERSION = "@VERSION@"
CONFIG_DIR = Path(os.environ.get("NETCAP_CONFIG_DIR")
                  or Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "netcap")
ROOT = Path(__file__).resolve().parent.parent
EXAMPLES = ROOT / "examples"
# Filled by main() from CONFIG_DIR/hosts. {name: {"os": "mac"|"linux"|"win", "ssh": Host name | None}}
HOSTS = {}
ORDER = []
# Every request to mac goes through this entry point. If the device's authorized_keys pins
# this agent as the forced command, only the verbs that device allows get through
MAC_AGENT = "/Library/PrivilegedHelperTools/netcap-agent"
LINUX_AGENT = "/usr/libexec/netcap/netcap-agent"
WIN_AGENT = r"C:\ProgramData\netcap\netcap-agent.ps1"
SSH_OPTS = ["-o", "BatchMode=yes", "-o", "ConnectTimeout=6", "-o", "ServerAliveInterval=5"]
# The key netcap install registers on devices, pinned there to the agent (forced command).
# It is offered first; a device without it falls back to the keys of the user's own ssh config
KEY = Path.home() / ".ssh" / "netcap"
VERBS = "status get check on off set"
# check does not return until the transfer ends. Capped at 1 Mbit/s, 1MB takes almost 10 seconds
TIMEOUT = {"check": 180}


def locale_name():
    """The message locale, in the order POSIX looks it up: LC_ALL, LC_MESSAGES, LANG."""
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        if os.environ.get(var):
            return os.environ[var]
    return ""


def _(msg):
    """Translate a message for people. A message with no translation stays in English.
    Never pass it what a machine reads: --json, key=value, or the values in the table"""
    if locale_name().startswith("ja"):
        return JA.get(msg, msg)
    return msg


def build_cmd(host, action, args):
    """Build the command to run on a device. For devices behind ssh, join it into one string."""
    h = HOSTS[host]
    if h["os"] in ("mac", "linux"):
        remote = [MAC_AGENT if h["os"] == "mac" else LINUX_AGENT, action, *args]
    else:
        remote = ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", WIN_AGENT, action, *args]
    if h["ssh"] is None:
        return remote
    # OpenSSH on Windows splits the arguments too, so this form works there as well
    # ControlPath=none: a shared connection (ControlMaster) from the user's own login would carry the request
    # past the netcap key and its forced command
    key = ["-i", str(KEY), "-o", "ControlPath=none"] if KEY.exists() else []
    return ["ssh", *SSH_OPTS, *key, h["ssh"], " ".join(shlex.quote(a) for a in remote)]


def decode(b):
    """Decode a device's output. Try UTF-8 first, then cp932.
    On Japanese Windows, PowerShell over ssh returns UTF-8, while standard commands such as
    icacls return the OEM code page (cp932) (measured on a real machine, 2026-09-25)"""
    try:
        return b.decode("utf-8")
    except UnicodeDecodeError:
        return b.decode("cp932", errors="replace")


def run(host, action, args=()):
    """Run one command on a device and return the parsed dict."""
    cmd = build_cmd(host, action, list(args))
    try:
        p = subprocess.run(cmd, capture_output=True, timeout=TIMEOUT.get(action, 60))
    except subprocess.TimeoutExpired:
        return {"host": host, "reach": "timeout", "raw": ""}
    except FileNotFoundError as e:  # netcap-agent is not installed on this machine
        return {"host": host, "reach": "no-agent", "raw": str(e)}
    out = decode(p.stdout) + decode(p.stderr)
    res = {"host": host, "raw": out.strip(), "rc": p.returncode}
    if p.returncode == 255 and HOSTS[host]["ssh"]:
        res["reach"] = "unreachable"
        return res
    res["reach"] = "ok"
    if "a password is required" in out or "sudo: a terminal is required" in out:
        res["reach"] = "no-sudo"  # sudoers is not installed
    elif p.returncode != 0 and any(l.startswith("netcap-agent: ") for l in out.splitlines()):
        # The device does not allow this verb (forced command). The agent exits with 77, but on
        # Windows the default ssh shell (PowerShell) rounds non-zero to 1, so do not look at the value
        res["reach"] = "denied"
    elif p.returncode == 127 or (WIN_AGENT in out and ("does not exist" in out or "存在しません" in out)):
        res["reach"] = "no-agent"  # netcap-agent is not installed on the device (存在しません is what Japanese Windows says)
    # The device returns key=value on the first line. Pick it up
    for line in out.splitlines():
        if "=" in line and line.split()[0] in ("netshape", "netcheck"):
            for tok in line.split():
                if "=" in tok:
                    k, v = tok.split("=", 1)
                    res[k] = v
            break
    if p.returncode != 0 and res["reach"] == "ok":
        res["reach"] = "error"
    return res


def version():
    if not VERSION.startswith("@"):
        return VERSION
    try:
        p = subprocess.run(["git", "-C", str(Path(__file__).resolve().parent), "describe",
                            "--tags", "--always", "--dirty"], capture_output=True, text=True, timeout=5)
        if p.returncode == 0 and p.stdout.strip():
            return p.stdout.strip().removeprefix("v")
    except (OSError, subprocess.TimeoutExpired):
        pass
    return "unknown"


class VersionAction(argparse.Action):
    """Look up the version only when --version is given (do not run git every time)."""

    def __init__(self, option_strings, dest, **kwargs):
        super().__init__(option_strings, dest, nargs=0, help=_("print the version and exit"))

    def __call__(self, parser, namespace, values, option_string=None):
        print(f"netcap {version()}")
        parser.exit()


def config_lines(name):
    """Read CONFIG_DIR/name and yield (line number, words), skipping comments and blank lines."""
    path = CONFIG_DIR / name
    if not path.exists():
        sys.exit(_("{path} does not exist. See {example} for the format\n"
                   "  mkdir -p {dir} && cp {example} {path}").format(path=path, example=EXAMPLES / name, dir=CONFIG_DIR))
    for n, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        words = line.split("#", 1)[0].split()
        if words:
            yield path, n, words


def load_hosts():
    """hosts: one device per line, "name OS route". OS is mac / linux / win. route is a Host name in ~/.ssh/config, or - for this machine"""
    for path, n, words in config_lines("hosts"):
        if len(words) != 3 or words[1] not in ("mac", "linux", "win") or words[0] == "all":
            sys.exit(f"{path}:{n}: " + _("write 3 words, \"name mac|linux|win route\" (all is not allowed as a name): {line}")
                     .format(line=' '.join(words)))
        name, os_, ssh = words
        if name in HOSTS:
            sys.exit(f"{path}:{n}: " + _("{name} appears twice").format(name=name))
        HOSTS[name] = {"os": os_, "ssh": None if ssh == "-" else ssh}
        ORDER.append(name)
    if not HOSTS:
        sys.exit(_("{path} has no devices").format(path=CONFIG_DIR / "hosts"))


def host_names():
    return " | ".join([*ORDER, "all"])


def resolve(target, default_all=False):
    if target in (None, "all"):
        if target is None and not default_all:
            sys.exit(_("specify a host ({names})").format(names=host_names()))
        return ORDER
    if target not in HOSTS:
        sys.exit(_("unknown host: {host} (one of {names})").format(host=target, names=host_names()))
    return [target]


def fan_out(hosts, action, args=()):
    with ThreadPoolExecutor(max_workers=len(hosts)) as ex:
        return list(ex.map(lambda h: run(h, action, list(args)), hosts))


def fmt(v):
    return "-" if v in (None, "", "-") else v


def print_table(rows, cols, footnote=None):
    """cols are (header, width, function that makes the value). Width 0 is the last, variable-width column."""
    head = "  ".join(f"{c:<{w}}" if w else c for c, w, _ in cols)
    print(head)
    print("-" * max(len(head), 60))
    for r in rows:
        vals = [f(r) for _, _, f in cols]
        print("  ".join(f"{v:<{w}}" if w else v for v, (_, w, _) in zip(vals, cols)))
    if footnote and any(r.get("down_src") == "applied" for r in rows):
        print(_(footnote))


def note(r):
    """For devices that were not reached, show why from the last line."""
    if r.get("reach") == "ok":
        return ""
    return (r.get("raw", "").splitlines() or [""])[-1]


DOWN_NOTE = "* download is the value recorded at on, because dnctl on macOS cannot show the bandwidth of pipe 2 (the pipe itself was verified)"

STATUS_COLS = [
    ("host", 7, lambda r: r["host"]),
    ("reach", 12, lambda r: r.get("reach", "?")),
    ("cap", 8, lambda r: r.get("state", "?") if r.get("reach") == "ok" else "?"),
    ("up", 11, lambda r: "-" if fmt(r.get("up_mbit")) == "-" else f"{r['up_mbit']} Mbit/s"),
    ("down", 11, lambda r: "unsupported" if r.get("down_src") == "unsupported"
     else "-" if fmt(r.get("down_mbit")) == "-"
     else f"{r['down_mbit']} Mbit/s" + ("*" if r.get("down_src") == "applied" else "")),
    ("note", 0, note),
]

GET_COLS = [
    ("host", 7, lambda r: r["host"]),
    ("reach", 12, lambda r: r.get("reach", "?")),
    ("default", 12, lambda r: "-" if fmt(r.get("default_up")) == "-"
     else f"{r['default_up']}/{r['default_down']} Mbit/s"),
    ("boot", 6, lambda r: fmt(r.get("boot"))),
    ("agent", 10, lambda r: fmt(r.get("agent"))),
    ("note", 0, note),
]

CHECK_COLS = [
    ("host", 7, lambda r: r["host"]),
    ("reach", 12, lambda r: r.get("reach", "?")),
    ("down", 11, lambda r: "-" if fmt(r.get("down_mbit")) == "-" else f"{r['down_mbit']} Mbit/s"),
    ("up", 11, lambda r: "-" if fmt(r.get("up_mbit")) == "-" else f"{r['up_mbit']} Mbit/s"),
    ("ping med/p95/max (ms)", 22, lambda r: "-" if fmt(r.get("ping_med")) == "-"
     else f"{r['ping_med']}/{r['ping_p95']}/{r['ping_max']} (n={r.get('ping_n', '?')})"),
    ("note", 0, note),
]


def emit(rows, cols, as_json, raw=False, footnote=DOWN_NOTE):
    if as_json:
        print(json.dumps(rows, ensure_ascii=False, indent=2))
    else:
        print_table(rows, cols, footnote)
        if raw:
            for r in rows:
                print(f"\n=== {r['host']}\n{r.get('raw', '')}")
    return 0 if all(r.get("reach") == "ok" for r in rows) else 1


def apply_and_read(hosts, action, args, as_json, raw):
    """After changing the state, read back the real state instead of returning the requested values."""
    changed = fan_out(hosts, action, args)
    after = fan_out(hosts, "status")
    rows = []
    for c, s in zip(changed, after):
        if c.get("reach") == "ok" and s.get("reach") == "ok":
            s["raw"] = c["raw"] + "\n" + s["raw"]
            rows.append(s)
        else:
            rows.append(c)
    return emit(rows, STATUS_COLS, as_json, raw)


def load_profiles():
    """profiles: one set per line, "name device=value device=value …". The same form netcap profiles prints"""
    profiles = {}
    for path, n, words in config_lines("profiles"):
        name, *pairs = words
        if not pairs or any("=" not in p for p in pairs):
            sys.exit(f"{path}:{n}: " + _("write \"name device=up/down …\": {line}").format(line=' '.join(words)))
        profiles[name] = dict(p.split("=", 1) for p in pairs)
    return profiles


def is_mbit(v):
    """A cap in Mbit/s: a positive number. 0 is refused, because dummynet on macOS reads bw 0 as unlimited"""
    return re.fullmatch(r"[0-9]+(\.[0-9]+)?", v) is not None and float(v) > 0


def parse_profile_value(host, value):
    """"2/3" → ("on", ["2", "3"]) / "off" → ("off", [])"""
    if value == "off":
        return "off", []
    if value == "on":
        return "on", []
    if "/" in value:
        up, down = (v.strip() for v in value.split("/", 1))
        if is_mbit(up) and is_mbit(down):
            return "on", [up, down]
    sys.exit(_("cannot read the profile value: {host} = {value!r} (\"up/down\" in positive Mbit/s, or \"off\")").format(host=host, value=value))


def cmd_use(a):
    profiles = load_profiles()
    if a.profile not in profiles:
        sys.exit(_("unknown profile: {profile} (available: {names})").format(profile=a.profile, names=", ".join(profiles)))
    plan = profiles[a.profile]
    unknown = [h for h in plan if h not in HOSTS]
    if unknown:
        sys.exit(_("the profile has unknown hosts: {names}").format(names=", ".join(unknown)))
    hosts = [h for h in ORDER if h in plan]  # devices not listed are left untouched

    def one(host):
        action, args = parse_profile_value(host, plan[host])
        return run(host, action, args)

    with ThreadPoolExecutor(max_workers=len(hosts)) as ex:
        list(ex.map(one, hosts))
    rows = fan_out(hosts, "status")
    if not a.json:
        print(f"profile: {a.profile}")
    return emit(rows, STATUS_COLS, a.json, a.raw)


def cmd_profiles(a):
    profiles = load_profiles()
    if a.json:
        print(json.dumps(profiles, ensure_ascii=False, indent=2))
        return 0
    width = max(len(n) for n in profiles) if profiles else 8
    for name, plan in profiles.items():
        body = "  ".join(f"{h}={plan[h]}" for h in ORDER if h in plan)
        print(f"{name:<{width}}  {body}")
    return 0


def add_target(p, optional=False):
    p.add_argument("host", nargs="?" if optional else None, help=_("a name from hosts, or all"))


# --- install / uninstall / rename ---------------------------------------------------------------
# netcap install does what host-setup.md used to ask people to do by hand: copy the device side,
# run its installer (sudo / Administrator), register the netcap key as a forced command, and add hosts.

NAME_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]*")
THIS_OS = {"darwin": "mac", "linux": "linux", "win32": "win"}.get(sys.platform)


def say(msg):
    print(f"==> {msg}", flush=True)


def ssh_plain(dest, cmd, tty=False, input=None, capture=True):
    """ssh with the user's own keys (not the netcap key, which only reaches the agent)."""
    opts = ["-t"] if tty else ["-o", "BatchMode=yes"]
    p = subprocess.run(["ssh", *opts, "-o", "ConnectTimeout=10", dest, cmd], input=input,
                       capture_output=capture)
    if capture:
        p.out = decode(p.stdout).strip()
        p.err = decode(p.stderr).strip()
    return p


def powershell(dest, script, capture=True):
    """Run a PowerShell script on a Windows device. -EncodedCommand avoids every quoting layer."""
    script = "$ProgressPreference = 'SilentlyContinue'; $ErrorActionPreference = 'Stop'\n" + script
    enc = base64.b64encode(script.encode("utf-16-le")).decode()
    return ssh_plain(dest, f"powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand {enc}", capture=capture)


def ps_quote(s):
    return "'" + s.replace("'", "''") + "'"


def detect_os(dest):
    p = ssh_plain(dest, "uname -s")
    if p.returncode == 255:
        sys.exit(_("cannot reach {dest} over ssh: {err}").format(dest=dest, err=p.err))
    if p.returncode == 0 and p.out in ("Darwin", "Linux"):
        return {"Darwin": "mac", "Linux": "linux"}[p.out]
    if "Win32NT" in powershell(dest, "[Environment]::OSVersion.Platform").out:
        return "win"
    sys.exit(_("cannot tell the OS of {dest} (uname: {out})").format(dest=dest, out=p.out or p.err))


def stage():
    """Copy the device side into a temporary directory, with this CLI's version written into the agents."""
    tmp = Path(tempfile.mkdtemp(prefix="netcap-"))
    for d in ("mac", "linux", "win"):
        shutil.copytree(ROOT / d, tmp / d)
    for agent in (tmp / "mac" / "netcap-agent", tmp / "win" / "netcap-agent.ps1"):
        # Spelled in two parts: the formula replaces every quoted placeholder in this file at install time
        agent.write_bytes(agent.read_bytes().replace(b"@" b"VERSION@", version().encode()))
    return tmp


def ensure_key():
    if not KEY.exists():
        KEY.parent.mkdir(mode=0o700, exist_ok=True)
        subprocess.run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-f", str(KEY),
                        "-C", f"netcap@{socket.gethostname().split('.')[0]}"], check=True)
        say(_("created the netcap key: {key}").format(key=KEY))
    pub = KEY.with_suffix(".pub").read_text().strip()
    return pub, pub.split()[1]


def key_line(os_, pub):
    """The authorized_keys line that pins the netcap key to the agent (docs/host-setup.md)."""
    if os_ == "win":
        agent = f"powershell -NoProfile -ExecutionPolicy Bypass -File {WIN_AGENT}"
    else:
        agent = MAC_AGENT if os_ == "mac" else LINUX_AGENT
    return f"restrict,command=\"{agent} --allow '{VERBS}'\" {pub}"


# Append the line unless the key is already there. Keep the file's last line intact
UNIX_AUTHORIZE = """umask 077; mkdir -p ~/.ssh; f=~/.ssh/authorized_keys; touch "$f"
grep -qF '{blob}' "$f" && exit 0
if [ -s "$f" ] && [ -n "$(tail -c1 "$f")" ]; then echo >> "$f"; fi
cat >> "$f" <<'NETCAP_EOF'
{line}
NETCAP_EOF
"""
UNIX_UNAUTHORIZE = """f=~/.ssh/authorized_keys; [ -f "$f" ] || exit 0
grep -vF '{blob}' "$f" > "$f.netcap" || true
cat "$f.netcap" > "$f"; rm -f "$f.netcap"
"""
# sshd reads this file for administrators and silently ignores it if it is UTF-16 or writable by others,
# so write UTF-8 and give a new file the ACL sshd wants (SYSTEM and Administrators only)
WIN_KEYS = r"$f = Join-Path $env:ProgramData 'ssh\administrators_authorized_keys'" + "\n"
WIN_AUTHORIZE = WIN_KEYS + """$new = -not (Test-Path $f)
if (-not $new -and ([IO.File]::ReadAllText($f)).Contains({blob})) {{ exit 0 }}
if (-not $new) {{ $b = [IO.File]::ReadAllBytes($f); if ($b.Length -gt 0 -and $b[-1] -ne 10) {{ [IO.File]::AppendAllText($f, "`r`n") }} }}
[IO.File]::AppendAllText($f, {line} + "`r`n")
if ($new) {{ icacls.exe $f /inheritance:r /grant:r '*S-1-5-18:F' '*S-1-5-32-544:F' | Out-Null }}
"""
WIN_UNAUTHORIZE = WIN_KEYS + """if (-not (Test-Path $f)) { exit 0 }
[IO.File]::WriteAllLines($f, [string[]]@([IO.File]::ReadAllLines($f) | Where-Object { -not $_.Contains(BLOB) }))
"""


def authorize(dest, os_):
    pub, blob = ensure_key()
    line = key_line(os_, pub)
    if os_ == "win":
        p = powershell(dest, WIN_AUTHORIZE.format(blob=ps_quote(blob), line=ps_quote(line)))
    else:
        p = ssh_plain(dest, "sh -s", input=UNIX_AUTHORIZE.format(blob=blob, line=line).encode())
    if p.returncode != 0:
        sys.exit(_("could not register the netcap key on {dest}: {err}").format(dest=dest, err=p.err))


def unauthorize(dest, os_):
    if not KEY.with_suffix(".pub").exists():
        return
    blob = KEY.with_suffix(".pub").read_text().split()[1]
    if os_ == "win":
        p = powershell(dest, WIN_UNAUTHORIZE.replace("BLOB", ps_quote(blob)))
    else:
        p = ssh_plain(dest, "sh -s", input=UNIX_UNAUTHORIZE.format(blob=blob).encode())
    if p.returncode != 0:
        sys.exit(_("could not remove the netcap key on {dest}: {err}").format(dest=dest, err=p.err))


def run_device_script(dest, os_, script, args=()):
    """Run mac|linux/<script> (install.sh / uninstall.sh) or win\\<script> on a device, from a staged copy.
    dest None means this machine. Output goes straight to the terminal: sudo may ask for a password."""
    src = stage()
    try:
        if dest is None:
            if os_ == "win":
                cmd = ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", str(src / "win" / script), *args]
            else:
                cmd = ["sudo", "bash", str(src / os_ / script), *args]
            return subprocess.run(cmd).returncode
        if os_ == "win":
            tmp = powershell(dest, "$d = Join-Path $env:TEMP ('netcap-' + [guid]::NewGuid()); "
                                   "New-Item -ItemType Directory $d | Out-Null; $d").out.splitlines()[-1]
            scp = subprocess.run(["scp", "-q", "-r", str(src / "win"), f"{dest}:{tmp.replace(chr(92), '/')}/"])
            if scp.returncode != 0:
                return scp.returncode
            return powershell(dest, f"try {{ & (Join-Path {ps_quote(tmp)} 'win\\{script}') {' '.join(args)}; "
                                    f"exit $LASTEXITCODE }} finally {{ Remove-Item -Recurse -Force {ps_quote(tmp)} }}",
                              capture=False).returncode
        tmp = ssh_plain(dest, "mktemp -d /tmp/netcap.XXXXXX").out
        if not tmp.startswith("/tmp/netcap."):
            sys.exit(_("could not make a temporary directory on {dest}").format(dest=dest))
        # linux/install.sh also takes the agent and netcap-check from ../mac
        scp = subprocess.run(["scp", "-q", "-r", str(src / "mac"), str(src / "linux"), f"{dest}:{tmp}/"])
        if scp.returncode != 0:
            return scp.returncode
        cmd = f"sudo bash {tmp}/{os_}/{script} {' '.join(args)}; rc=$?; rm -rf {tmp}; exit $rc"
        return ssh_plain(dest, cmd, tty=sys.stdin.isatty(), capture=False).returncode
    finally:
        shutil.rmtree(src, ignore_errors=True)


def read_hosts():
    """Load hosts if there is one (install starts from nothing)."""
    if (CONFIG_DIR / "hosts").exists() and any(config_lines("hosts")):
        load_hosts()


def edit_config(name, fn):
    """Rewrite CONFIG_DIR/name line by line. fn gets the part before # and returns the new part, or None to drop the line."""
    path = CONFIG_DIR / name
    if not path.exists():
        return
    out = []
    for line in path.read_text(encoding="utf-8").splitlines():
        code, sep, comment = line.partition("#")
        if not code.strip():
            out.append(line)
            continue
        new = fn(code)
        if new is not None:
            out.append(new + sep + comment)
    path.write_text("".join(l + "\n" for l in out), encoding="utf-8")


def ask_name(default):
    if not sys.stdin.isatty():
        return default
    return input(_("Name for this device in netcap (Enter for {default}): ").format(default=default)).strip() or default


def check_name(name):
    if not NAME_RE.fullmatch(name) or name == "all":
        sys.exit(_("cannot use {name!r} as a name (letters, digits, _ . -; not all)").format(name=name))


def cmd_install(a):
    read_hosts()
    if a.name in HOSTS and a.ssh is None:  # reinstall (update) a registered device
        name, os_, dest = a.name, HOSTS[a.name]["os"], HOSTS[a.name]["ssh"]
    else:
        dest = a.ssh
        name = a.name or ask_name(dest or "me")
        check_name(name)
        if dest is None and THIS_OS is None:
            sys.exit(_("this OS is not supported: {os}").format(os=sys.platform))
        os_ = THIS_OS if dest is None else detect_os(dest)
        if name in HOSTS and (HOSTS[name]["os"], HOSTS[name]["ssh"]) != (os_, dest):
            sys.exit(_("{name} is already another device in hosts. Choose another name, or: netcap rename {name} <new>")
                     .format(name=name))
    where = dest or _("this machine")
    say(_("installing the agent on {where} ({os})").format(where=where, os=os_))
    args = [] if os_ == "win" else ["--boot", a.boot]
    if run_device_script(dest, os_, "install.ps1" if os_ == "win" else "install.sh", args) != 0:
        sys.exit(_("the install on {where} failed (see above)").format(where=where))
    if dest is not None:
        say(_("registering the netcap key on {dest}").format(dest=dest))
        authorize(dest, os_)
    if name not in HOSTS:
        path = CONFIG_DIR / "hosts"
        path.parent.mkdir(parents=True, exist_ok=True)
        text = path.read_text(encoding="utf-8") if path.exists() else ""
        if text and not text.endswith("\n"):
            text += "\n"
        path.write_text(text + f"{name:<8} {os_:<5} {dest or '-'}\n", encoding="utf-8")
        HOSTS[name] = {"os": os_, "ssh": dest}
        ORDER.append(name)
        say(_("added {name} to {path}").format(name=name, path=path))
    rc = emit([run(name, "get")], GET_COLS, a.json, a.raw)
    if not a.json:
        print(_("\nTry it:  netcap on {name} --up 2 --down 2\nUndo:    netcap off {name}").format(name=name))
    return rc


def cmd_uninstall(a):
    load_hosts()
    if a.name == "all":
        sys.exit(_("uninstall one device at a time"))
    resolve(a.name)
    os_, dest = HOSTS[a.name]["os"], HOSTS[a.name]["ssh"]
    if not a.config_only:
        where = dest or _("this machine")
        say(_("removing the agent from {where}").format(where=where))
        if run_device_script(dest, os_, "uninstall.ps1" if os_ == "win" else "uninstall.sh") != 0:
            sys.exit(_("the uninstall on {where} failed (see above). To only forget it here: "
                       "netcap uninstall {name} --config-only").format(where=where, name=a.name))
        if dest is not None:
            unauthorize(dest, os_)
    name = re.escape(a.name)
    edit_config("hosts", lambda c: None if c.split()[0] == a.name else c)
    dropped = []

    def drop(code):
        new = re.sub(rf"\s+{name}=\S+", "", code)
        if new != code and len(new.split()) == 1:
            dropped.append(new.split()[0])
            return None
        return new
    edit_config("profiles", drop)
    say(_("removed {name} from hosts and profiles").format(name=a.name))
    if dropped:
        say(_("removed profiles that had only {name}: {profiles}").format(name=a.name, profiles=", ".join(dropped)))
    return 0


def cmd_rename(a):
    load_hosts()
    if a.old not in HOSTS:
        sys.exit(_("unknown host: {host} (one of {names})").format(host=a.old, names=host_names()))
    check_name(a.new)
    if a.new in HOSTS:
        sys.exit(_("{name} is already in hosts").format(name=a.new))
    old = re.escape(a.old)
    edit_config("hosts", lambda c: re.sub(rf"^(\s*){old}(?=\s)", lambda m: m.group(1) + a.new, c))
    edit_config("profiles", lambda c: re.sub(rf"(?<=\s){old}=", a.new + "=", c))
    say(_("renamed {old} to {new} in hosts and profiles").format(old=a.old, new=a.new))
    return 0


