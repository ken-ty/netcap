#!/usr/bin/env python3
"""netcap — one command for the WAN bandwidth caps of the devices you manage.

  netcap status [host|all] [--json]           read the real state (pf pipes / QoS policy)
  netcap get    [host|all] [--json]           read the settings (default, boot behavior)
  netcap on     <host|all> [--up N --down N]  apply a cap; flags apply this time only
  netcap off    <host|all>                    remove the cap
  netcap set    <host|all> --up N --down N    change the default (survives reboots)
  netcap check  <host|all> [--json]           measure (curl up/down + ping)
  netcap use    <profile>                     apply a profile to all devices
  netcap profiles                             list profiles
  netcap --version                            version (also -v)

The command layout is borrowed from tailscale. status (real state) and get (settings) are separate
commands, set changes only the persistent settings, and the flags of on are "the complete desired state
for this time". Only the verbs are not borrowed: netcap's domain already uses up/down for upload and
download, so it keeps on/off instead of tailscale's up/down.

What runs on each device:
  mac              : /Library/PrivilegedHelperTools/netcap-agent    (entry point; also the forced command)
                       → netcap-netshape (pf + dummynet; sudo -n) / netcap-check (measurement; no root)
  linux            : /usr/libexec/netcap/netcap-agent               (entry point; the same agent as mac)
                       → netcap-netshape (tc; sudo -n) / netcap-check (measurement; no root)
  win              : C:\\ProgramData\\netcap\\netcap-agent.ps1        (entry point; also the forced command)
                       → netshape.ps1 (NetQosPolicy; upload only) / netcap-check.ps1 (measurement)
Each returns key=value on its first line, which is what gets read.

Which devices to manage (hosts) and which to move together (profiles) belong to the user.
They are not in the code but in ~/.config/netcap/ (override with $NETCAP_CONFIG_DIR).
See examples/ for the format. Both are plain text, one entry per line; everything after # is a comment.
"""
import argparse
import json
import os
import re
import shlex
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

# The brew formula replaces this with the version (the tag without the v) at install time.
# If it was not replaced, we are running straight from the repository, so use git describe
VERSION = "@VERSION@"
CONFIG_DIR = Path(os.environ.get("NETCAP_CONFIG_DIR")
                  or Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "netcap")
EXAMPLES = Path(__file__).resolve().parent.parent / "examples"
# Filled by main() from CONFIG_DIR/hosts. {name: {"os": "mac"|"linux"|"win", "ssh": Host name | None}}
HOSTS = {}
ORDER = []
# Every request to mac goes through this entry point. If the device's authorized_keys pins
# this agent as the forced command, only the verbs that device allows get through
MAC_AGENT = "/Library/PrivilegedHelperTools/netcap-agent"
LINUX_AGENT = "/usr/libexec/netcap/netcap-agent"
WIN_AGENT = r"C:\ProgramData\netcap\netcap-agent.ps1"
SSH_OPTS = ["-o", "BatchMode=yes", "-o", "ConnectTimeout=6", "-o", "ServerAliveInterval=5"]
# check does not return until the transfer ends. Capped at 1 Mbit/s, 1MB takes almost 10 seconds
TIMEOUT = {"check": 180}


def locale_name():
    """The message locale, in the order POSIX looks it up: LC_ALL, LC_MESSAGES, LANG."""
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        if os.environ.get(var):
            return os.environ[var]
    return ""


def _(msg):
    """Translate a message for people. A message with no translation stays in English.
    Never pass it what a machine reads: --json, key=value, or the values in the table"""
    if locale_name().startswith("ja"):
        return JA.get(msg, msg)
    return msg


def build_cmd(host, action, args):
    """Build the command to run on a device. For devices behind ssh, join it into one string."""
    h = HOSTS[host]
    if h["os"] in ("mac", "linux"):
        remote = [MAC_AGENT if h["os"] == "mac" else LINUX_AGENT, action, *args]
    else:
        remote = ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", WIN_AGENT, action, *args]
    if h["ssh"] is None:
        return remote
    # OpenSSH on Windows splits the arguments too, so this form works there as well
    return ["ssh", *SSH_OPTS, h["ssh"], " ".join(shlex.quote(a) for a in remote)]


def decode(b):
    """Decode a device's output. Try UTF-8 first, then cp932.
    On Japanese Windows, PowerShell over ssh returns UTF-8, while standard commands such as
    icacls return the OEM code page (cp932) (measured on a real machine, 2026-09-25)"""
    try:
        return b.decode("utf-8")
    except UnicodeDecodeError:
        return b.decode("cp932", errors="replace")


def run(host, action, args=()):
    """Run one command on a device and return the parsed dict."""
    cmd = build_cmd(host, action, list(args))
    try:
        p = subprocess.run(cmd, capture_output=True, timeout=TIMEOUT.get(action, 60))
    except subprocess.TimeoutExpired:
        return {"host": host, "reach": "timeout", "raw": ""}
    except FileNotFoundError as e:  # netcap-agent is not installed on this machine
        return {"host": host, "reach": "no-agent", "raw": str(e)}
    out = decode(p.stdout) + decode(p.stderr)
    res = {"host": host, "raw": out.strip(), "rc": p.returncode}
    if p.returncode == 255 and HOSTS[host]["ssh"]:
        res["reach"] = "unreachable"
        return res
    res["reach"] = "ok"
    if "a password is required" in out or "sudo: a terminal is required" in out:
        res["reach"] = "no-sudo"  # sudoers is not installed
    elif p.returncode != 0 and any(l.startswith("netcap-agent: ") for l in out.splitlines()):
        # The device does not allow this verb (forced command). The agent exits with 77, but on
        # Windows the default ssh shell (PowerShell) rounds non-zero to 1, so do not look at the value
        res["reach"] = "denied"
    elif p.returncode == 127 or (WIN_AGENT in out and ("does not exist" in out or "存在しません" in out)):
        res["reach"] = "no-agent"  # netcap-agent is not installed on the device (存在しません is what Japanese Windows says)
    # The device returns key=value on the first line. Pick it up
    for line in out.splitlines():
        if "=" in line and line.split()[0] in ("netshape", "netcheck"):
            for tok in line.split():
                if "=" in tok:
                    k, v = tok.split("=", 1)
                    res[k] = v
            break
    if p.returncode != 0 and res["reach"] == "ok":
        res["reach"] = "error"
    return res


def version():
    if not VERSION.startswith("@"):
        return VERSION
    try:
        p = subprocess.run(["git", "-C", str(Path(__file__).resolve().parent), "describe",
                            "--tags", "--always", "--dirty"], capture_output=True, text=True, timeout=5)
        if p.returncode == 0 and p.stdout.strip():
            return p.stdout.strip().removeprefix("v")
    except (OSError, subprocess.TimeoutExpired):
        pass
    return "unknown"


class VersionAction(argparse.Action):
    """Look up the version only when --version is given (do not run git every time)."""

    def __init__(self, option_strings, dest, **kwargs):
        super().__init__(option_strings, dest, nargs=0, help=_("print the version and exit"))

    def __call__(self, parser, namespace, values, option_string=None):
        print(f"netcap {version()}")
        parser.exit()


def config_lines(name):
    """Read CONFIG_DIR/name and yield (line number, words), skipping comments and blank lines."""
    path = CONFIG_DIR / name
    if not path.exists():
        sys.exit(_("{path} does not exist. See {example} for the format\n"
                   "  mkdir -p {dir} && cp {example} {path}").format(path=path, example=EXAMPLES / name, dir=CONFIG_DIR))
    for n, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        words = line.split("#", 1)[0].split()
        if words:
            yield path, n, words


def load_hosts():
    """hosts: one device per line, "name OS route". OS is mac / linux / win. route is a Host name in ~/.ssh/config, or - for this machine"""
    for path, n, words in config_lines("hosts"):
        if len(words) != 3 or words[1] not in ("mac", "linux", "win") or words[0] == "all":
            sys.exit(f"{path}:{n}: " + _("write 3 words, \"name mac|linux|win route\" (all is not allowed as a name): {line}")
                     .format(line=' '.join(words)))
        name, os_, ssh = words
        if name in HOSTS:
            sys.exit(f"{path}:{n}: " + _("{name} appears twice").format(name=name))
        HOSTS[name] = {"os": os_, "ssh": None if ssh == "-" else ssh}
        ORDER.append(name)
    if not HOSTS:
        sys.exit(_("{path} has no devices").format(path=CONFIG_DIR / "hosts"))


def host_names():
    return " | ".join([*ORDER, "all"])


def resolve(target, default_all=False):
    if target in (None, "all"):
        if target is None and not default_all:
            sys.exit(_("specify a host ({names})").format(names=host_names()))
        return ORDER
    if target not in HOSTS:
        sys.exit(_("unknown host: {host} (one of {names})").format(host=target, names=host_names()))
    return [target]


def fan_out(hosts, action, args=()):
    with ThreadPoolExecutor(max_workers=len(hosts)) as ex:
        return list(ex.map(lambda h: run(h, action, list(args)), hosts))


def fmt(v):
    return "-" if v in (None, "", "-") else v


def print_table(rows, cols, footnote=None):
    """cols are (header, width, function that makes the value). Width 0 is the last, variable-width column."""
    head = "  ".join(f"{c:<{w}}" if w else c for c, w, _ in cols)
    print(head)
    print("-" * max(len(head), 60))
    for r in rows:
        vals = [f(r) for _, _, f in cols]
        print("  ".join(f"{v:<{w}}" if w else v for v, (_, w, _) in zip(vals, cols)))
    if footnote and any(r.get("down_src") == "applied" for r in rows):
        print(_(footnote))


def note(r):
    """For devices that were not reached, show why from the last line."""
    if r.get("reach") == "ok":
        return ""
    return (r.get("raw", "").splitlines() or [""])[-1]


DOWN_NOTE = "* download is the value recorded at on, because dnctl on macOS cannot show the bandwidth of pipe 2 (the pipe itself was verified)"

STATUS_COLS = [
    ("host", 7, lambda r: r["host"]),
    ("reach", 12, lambda r: r.get("reach", "?")),
    ("cap", 8, lambda r: r.get("state", "?") if r.get("reach") == "ok" else "?"),
    ("up", 11, lambda r: "-" if fmt(r.get("up_mbit")) == "-" else f"{r['up_mbit']} Mbit/s"),
    ("down", 11, lambda r: "unsupported" if r.get("down_src") == "unsupported"
     else "-" if fmt(r.get("down_mbit")) == "-"
     else f"{r['down_mbit']} Mbit/s" + ("*" if r.get("down_src") == "applied" else "")),
    ("note", 0, note),
]

GET_COLS = [
    ("host", 7, lambda r: r["host"]),
    ("reach", 12, lambda r: r.get("reach", "?")),
    ("default", 12, lambda r: "-" if fmt(r.get("default_up")) == "-"
     else f"{r['default_up']}/{r['default_down']} Mbit/s"),
    ("boot", 6, lambda r: fmt(r.get("boot"))),
    ("note", 0, note),
]

CHECK_COLS = [
    ("host", 7, lambda r: r["host"]),
    ("reach", 12, lambda r: r.get("reach", "?")),
    ("down", 11, lambda r: "-" if fmt(r.get("down_mbit")) == "-" else f"{r['down_mbit']} Mbit/s"),
    ("up", 11, lambda r: "-" if fmt(r.get("up_mbit")) == "-" else f"{r['up_mbit']} Mbit/s"),
    ("ping med/p95/max (ms)", 22, lambda r: "-" if fmt(r.get("ping_med")) == "-"
     else f"{r['ping_med']}/{r['ping_p95']}/{r['ping_max']} (n={r.get('ping_n', '?')})"),
    ("note", 0, note),
]


def emit(rows, cols, as_json, raw=False, footnote=DOWN_NOTE):
    if as_json:
        print(json.dumps(rows, ensure_ascii=False, indent=2))
    else:
        print_table(rows, cols, footnote)
        if raw:
            for r in rows:
                print(f"\n=== {r['host']}\n{r.get('raw', '')}")
    return 0 if all(r.get("reach") == "ok" for r in rows) else 1


def apply_and_read(hosts, action, args, as_json, raw):
    """After changing the state, read back the real state instead of returning the requested values."""
    changed = fan_out(hosts, action, args)
    after = fan_out(hosts, "status")
    rows = []
    for c, s in zip(changed, after):
        if c.get("reach") == "ok" and s.get("reach") == "ok":
            s["raw"] = c["raw"] + "\n" + s["raw"]
            rows.append(s)
        else:
            rows.append(c)
    return emit(rows, STATUS_COLS, as_json, raw)


def load_profiles():
    """profiles: one set per line, "name device=value device=value …". The same form netcap profiles prints"""
    profiles = {}
    for path, n, words in config_lines("profiles"):
        name, *pairs = words
        if not pairs or any("=" not in p for p in pairs):
            sys.exit(f"{path}:{n}: " + _("write \"name device=up/down …\": {line}").format(line=' '.join(words)))
        profiles[name] = dict(p.split("=", 1) for p in pairs)
    return profiles


def parse_profile_value(host, value):
    """"2/3" → ("on", ["2", "3"]) / "off" → ("off", [])"""
    if value == "off":
        return "off", []
    if value == "on":
        return "on", []
    if "/" in value:
        up, down = value.split("/", 1)
        return "on", [up.strip(), down.strip()]
    sys.exit(_("cannot read the profile value: {host} = {value!r} (\"up/down\" or \"off\")").format(host=host, value=value))


def cmd_use(a):
    profiles = load_profiles()
    if a.profile not in profiles:
        sys.exit(_("unknown profile: {profile} (available: {names})").format(profile=a.profile, names=", ".join(profiles)))
    plan = profiles[a.profile]
    unknown = [h for h in plan if h not in HOSTS]
    if unknown:
        sys.exit(_("the profile has unknown hosts: {names}").format(names=", ".join(unknown)))
    hosts = [h for h in ORDER if h in plan]  # devices not listed are left untouched

    def one(host):
        action, args = parse_profile_value(host, plan[host])
        return run(host, action, args)

    with ThreadPoolExecutor(max_workers=len(hosts)) as ex:
        list(ex.map(one, hosts))
    rows = fan_out(hosts, "status")
    if not a.json:
        print(f"profile: {a.profile}")
    return emit(rows, STATUS_COLS, a.json, a.raw)


def cmd_profiles(a):
    profiles = load_profiles()
    if a.json:
        print(json.dumps(profiles, ensure_ascii=False, indent=2))
        return 0
    width = max(len(n) for n in profiles) if profiles else 8
    for name, plan in profiles.items():
        body = "  ".join(f"{h}={plan[h]}" for h in ORDER if h in plan)
        print(f"{name:<{width}}  {body}")
    return 0


def add_target(p, optional=False):
    p.add_argument("host", nargs="?" if optional else None, help=_("a name from hosts, or all"))


# Translations of the messages above, keyed by the English text. English is the source of truth:
# change the English first; a key left behind here is caught by the tests, a missing one falls back to English
JA = {
    __doc__: """netcap — 管理している機器の WAN 帯域の上限を、1 コマンドで扱う。

  netcap status [host|all] [--json]           実際の状態を読む (pf のパイプ / QoS ポリシー)
  netcap get    [host|all] [--json]           設定を読む (既定値、起動時の挙動)
  netcap on     <host|all> [--up N --down N]  上限をかける。--up/--down は今回だけ有効
  netcap off    <host|all>                    上限を外す
  netcap set    <host|all> --up N --down N    既定値を変える (再起動後も残る)
  netcap check  <host|all> [--json]           測る (curl の上り/下り + ping)
  netcap use    <profile>                     プロファイルを全機器に適用する
  netcap profiles                             プロファイルの一覧
  netcap --version                            バージョン (-v でも可)

コマンドの形は tailscale に倣っている。status (実際の状態) と get (設定) は別のコマンドで、
set は永続する設定だけを変え、on のフラグは「今回の望む状態のすべて」を表す。動詞だけは倣っていない。
netcap の領域では up/down が既に上り/下りの意味なので、tailscale の up/down ではなく on/off にしている。

各機器で動くもの:
  mac              : /Library/PrivilegedHelperTools/netcap-agent    (入口。forced command も兼ねる)
                       → netcap-netshape (pf + dummynet。sudo -n) / netcap-check (測定。root 不要)
