def main():
    argparse._ = _  # argparse's own words (usage:, options:, errors) go through the same table
    ap = argparse.ArgumentParser(prog="netcap", description=_(__doc__),
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("-v", "--version", action=VersionAction)
    ap.add_argument("--json", action="store_true", help=_("print in machine-readable form"))
    ap.add_argument("--raw", action="store_true", help=_("also print the raw output from the device"))
    # Also accept these after the subcommand, so the README form (netcap status all --json) works.
    # Without SUPPRESS, the subcommand's default False would overwrite a --json given before it
    out = argparse.ArgumentParser(add_help=False)
    out.add_argument("--json", action="store_true", default=argparse.SUPPRESS, help=_("print in machine-readable form"))
    out.add_argument("--raw", action="store_true", default=argparse.SUPPRESS, help=_("also print the raw output from the device"))
    sub = ap.add_subparsers(dest="cmd", required=True)
    _add = sub.add_parser
    sub.add_parser = lambda *a, **k: _add(*a, parents=[out], **k)

    p = sub.add_parser("status", help=_("read the real state (pf pipes / QoS policy)"))
    add_target(p, optional=True)
    p = sub.add_parser("get", help=_("read the settings (default, boot behavior)"))
    add_target(p, optional=True)
    p = sub.add_parser("on", help=_("apply a cap; --up/--down apply this time only"))
    add_target(p)
    p.add_argument("--up", metavar="MBIT")
    p.add_argument("--down", metavar="MBIT")
    p.add_argument("values", nargs="*", help=argparse.SUPPRESS)  # to catch the old form
    p = sub.add_parser("off", help=_("remove the cap"))
    add_target(p)
    p = sub.add_parser("set", help=_("change the default (survives reboots)"))
    add_target(p)
    p.add_argument("--up", metavar="MBIT")
    p.add_argument("--down", metavar="MBIT")
    p.add_argument("values", nargs="*", help=argparse.SUPPRESS)
    p = sub.add_parser("check", help=_("measure (curl up/down + ping)"))
    add_target(p, optional=True)
    p.add_argument("--bytes", metavar="N", help=_("bytes to transfer; use less while capped"))
    p = sub.add_parser("use", help=_("apply a profile to all devices"))
    p.add_argument("profile")
    sub.add_parser("profiles", help=_("list profiles"))
    p = sub.add_parser("install", help=_("install the agent on a device and register it (this machine without --ssh)"))
    p.add_argument("name", nargs="?", help=_("the device's name in hosts (asked when omitted); a registered name updates it"))
    p.add_argument("--ssh", metavar="DEST", help=_("ssh destination, such as a Host in ~/.ssh/config (omit for this machine)"))
    p.add_argument("--boot", choices=["on", "off"], default="off",
                   help=_("mac / linux: apply the default cap at boot (default: off)"))
    p = sub.add_parser("uninstall", help=_("remove the agent from a device and forget it"))
    p.add_argument("name")
    p.add_argument("--config-only", action="store_true", help=_("only forget it here (for a device that is gone)"))
    p = sub.add_parser("rename", help=_("rename a device in hosts and profiles"))
    p.add_argument("old")
    p.add_argument("new")

    a = ap.parse_args()
    if a.cmd in ("install", "uninstall", "rename"):
        return {"install": cmd_install, "uninstall": cmd_uninstall, "rename": cmd_rename}[a.cmd](a)
    load_hosts()

    if a.cmd in ("on", "set"):
        # The old form netcap set <host> 2 2 changed meaning. Do not silently do something else
        if a.values:
            sys.exit(_("values as positional arguments are no longer accepted ({given}).\n"
                       "  cap this time only : netcap on {host} --up N --down N\n"
                       "  change the default : netcap set {host} --up N --down N")
                     .format(given=f"{a.cmd} {a.host} {' '.join(a.values)}", host=a.host))
        # As with tailscale up, flags must describe the complete desired state
        if (a.up is None) != (a.down is None):
            sys.exit(_("give --up and --down together (with only one, the other would silently "
                       "stay at the default)"))
        if a.cmd == "set" and a.up is None:
            sys.exit(_("usage: netcap set <host|all> --up N --down N"))
        args = [a.up, a.down] if a.up is not None else []
        bad = [v for v in args if not is_mbit(v)]
        if bad:
            sys.exit(_("--up / --down must be positive numbers in Mbit/s: {values}").format(values=" ".join(bad)))
        rc = apply_and_read(resolve(a.host), a.cmd, args, a.json, a.raw)
        if a.cmd == "on" and not a.json:
            # The way back is printed right where it is needed, in case the cap makes it hard to look up
            print(_("to undo: netcap off {host}").format(host=a.host))
        return rc

    if a.cmd == "off":
        return apply_and_read(resolve(a.host), "off", [], a.json, a.raw)

    if a.cmd == "status":
        return emit(fan_out(resolve(a.host, default_all=True), "status"), STATUS_COLS, a.json, a.raw)

    if a.cmd == "get":
        rows = fan_out(resolve(a.host, default_all=True), "get")
        rc = emit(rows, GET_COLS, a.json, a.raw)
        # Point out agents that differ from this CLI (only for a release CLI; a clone's version has a git suffix)
        old = [r["host"] for r in rows if r.get("reach") == "ok" and r.get("agent") != version()]
        if old and not a.json and re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+", version()):
            print(_("\nThe agent differs from this CLI ({version}) on: {hosts}. Update with: netcap install <name>")
                  .format(version=version(), hosts=", ".join(old)))
        return rc

    if a.cmd == "check":
        args = ["--bytes", a.bytes] if a.bytes else []
        return emit(fan_out(resolve(a.host, default_all=True), "check", args),
                    CHECK_COLS, a.json, a.raw, footnote=None)

    if a.cmd == "use":
        return cmd_use(a)
    if a.cmd == "profiles":
        return cmd_profiles(a)


if __name__ == "__main__":
    sys.exit(main())
