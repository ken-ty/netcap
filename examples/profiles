# Sets of devices to switch together. One set per line: "name device=value device=value …"
#   value  "up/down" (Mbit/s) or off. Devices not listed are left alone
#   netcap use <name> applies one; netcap profiles lists them (in this same format)
game    laptop=2/2  server=1/1  gamepc=off
quiet   laptop=1/1  server=1/1
none    laptop=off  server=off  gamepc=off
