# Passwordless only for netcap-netshape's fixed verbs, so netcap can call it unattended.
# Location: /etc/sudoers.d/netcap-netshape (0440 root:root). Installed by linux/install.sh
#
# Arguments are spelled out. status / get / off / on without arguments match exactly.
# Only on / set, which take numbers, use * (sudoers' * matches anything, spaces included,
# so the shaper checks the count and form of arguments — exit 2 unless two numbers).
# The shaper lives in /usr/libexec/netcap, writable only by root.
# In a user-writable directory, replacing the file would be enough to get root.
Cmnd_Alias NETSHAPE = /usr/libexec/netcap/netcap-netshape status, \
                      /usr/libexec/netcap/netcap-netshape get, \
                      /usr/libexec/netcap/netcap-netshape off, \
                      /usr/libexec/netcap/netcap-netshape on, \
                      /usr/libexec/netcap/netcap-netshape on *, \
                      /usr/libexec/netcap/netcap-netshape set *
__USER__ ALL=(root) NOPASSWD: NETSHAPE
