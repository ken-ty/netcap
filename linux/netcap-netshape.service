# netcap-netshape — apply the default cap at boot. Installed only by linux/install.sh --boot on
[Unit]
Description=netcap: cap internet bandwidth at boot
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/netcap/netcap-netshape on
ExecStop=/usr/libexec/netcap/netcap-netshape off

[Install]
WantedBy=multi-user.target
